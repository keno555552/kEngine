{
    "code": "/// Cave: Terraria-like caves (small holes -> medium caves -> tunnels from the surface)\n/// tunnel(x, y, id, radius, length). How it turns is set by variables with the same name\n/// ---- Settings ----\nint airId = 0;\nint caveTop = 15;     // dig below this row\n\n/// Many small holes\nint turnEvery = 4;    // turn every n steps\nint turnAngle = 50;   // max turn per time (degrees)\nint branchMin = 0;    // number of branches (min)\nint branchMax = 0;    // number of branches (max)\nfloat roughness = 0.5;// edge roughness (0 = smooth)\nfloat endRatio = 0.7; // radius at the end (1 = no shrink)\nfor (int i = 0; i < 40; i++) { tunnel(srand(i * 2, 0, width), srand(i * 2 + 1, caveTop, height), airId, 1.5, 10); }\n\n/// Medium caves (with branches)\nturnEvery = 8;\nturnAngle = 30;\nbranchMin = 1;\nbranchMax = 2;\nroughness = 0.3;\nendRatio = 0.4;\nfor (int i = 0; i < 6; i++) { tunnel(srand(300 + i * 2, 0, width), srand(301 + i * 2, caveTop + 5, height), airId, 3.5, 60); }\n\n/// Long tunnels going down from the surface\nfloat dir = 80;       // direction (degrees: 0 = right, 90 = down, -1 = random)\nturnEvery = 12;\nturnAngle = 20;\nfor (int i = 0; i < 2; i++) { tunnel(srand(600 + i, 10, width - 10), 5, airId, 2.5, 90); }\n",
